{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclip.dev/schemas/prp/v1/request.schema.json",
  "title": "PRP request",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "requestKind",
        "requestId",
        "type",
        "status",
        "prompt",
        "turnId",
        "origin",
        "decisions",
        "permission"
      ],
      "properties": {
        "schema": { "const": "paperclip.runtime_request.permission.v1" },
        "requestKind": { "const": "runtime" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "permission" },
        "status": { "enum": ["pending", "resolved", "expired", "cancelled"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "turnId": { "type": "string", "minLength": 1, "maxLength": 240 },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 240 },
        "origin": {
          "type": "object",
          "required": ["adapter", "provider", "method"],
          "properties": {
            "adapter": { "const": "opencode-server" },
            "provider": { "const": "opencode" },
            "method": { "const": "permission.asked" }
          },
          "additionalProperties": false
        },
        "decisions": { "const": ["once", "reject"] },
        "permission": {
          "type": "object",
          "required": [
            "schema",
            "provider",
            "providerVersion",
            "providerSessionId",
            "providerRequestId",
            "permission",
            "tool",
            "patterns",
            "always",
            "metadata",
            "arguments",
            "cwd",
            "targets",
            "policy",
            "contractSha256"
          ],
          "properties": {
            "schema": { "const": "paperclip.opencode_permission_contract.v1" },
            "provider": { "const": "opencode" },
            "providerVersion": { "const": "1.18.29" },
            "providerSessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "providerRequestId": { "type": "string", "minLength": 1, "maxLength": 256 },
            "permission": { "type": "string", "minLength": 1, "maxLength": 160 },
            "tool": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["messageId", "callId"],
                  "properties": {
                    "messageId": { "type": "string", "minLength": 1, "maxLength": 256 },
                    "callId": { "type": "string", "minLength": 1, "maxLength": 256 }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "patterns": { "type": "array", "items": { "type": "string" } },
            "always": { "type": "array", "items": { "type": "string" } },
            "metadata": { "type": "object" },
            "arguments": { "type": ["object", "null"] },
            "cwd": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/" },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "resolvedPath"],
                "properties": {
                  "pattern": { "type": "string" },
                  "resolvedPath": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              }
            },
            "policy": {
              "type": "object",
              "required": ["profile", "permissionDefault"],
              "properties": {
                "profile": { "const": "restricted_v1" },
                "permissionDefault": { "const": "ask" }
              },
              "additionalProperties": false
            },
            "contractSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema", "requestKind", "requestId", "type", "status", "prompt", "input"],
      "properties": {
        "schema": { "const": "paperclip.runtime_request.v2" },
        "requestKind": { "const": "runtime" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "input" },
        "status": { "enum": ["pending", "resolved", "expired", "cancelled"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "input": { "$ref": "https://paperclip.dev/schemas/prp/v1/question-set.schema.json" },
        "origin": {
          "type": "object",
          "required": ["adapter"],
          "properties": {
            "adapter": { "type": "string", "minLength": 1, "maxLength": 160 },
            "provider": { "type": "string", "minLength": 1, "maxLength": 160 },
            "method": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "additionalProperties": false
        },
        "turnId": { "type": "string", "minLength": 1, "maxLength": 240 },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 240 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schema", "requestKind", "requestId", "type", "status", "prompt"],
      "properties": {
        "schema": { "const": "paperclip.runtime_request.v1" },
        "requestKind": { "const": "runtime" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "enum": ["permission", "input"] },
        "status": { "enum": ["pending", "resolved", "expired", "cancelled"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["schema", "requestKind", "requestId", "kind", "blocking", "payload"],
      "properties": {
        "schema": { "const": "paperclip.interaction_request.v1" },
        "requestKind": { "const": "issue_thread" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": {
          "enum": [
            "request_confirmation",
            "request_checkbox_confirmation",
            "request_item_verdicts",
            "ask_user_questions",
            "suggest_tasks"
          ]
        },
        "blocking": { "type": "boolean" },
        "payload": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  ]
}
